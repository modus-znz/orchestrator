# Copy to .env and fill in. The demo runs without any of these.
# Every value below is a placeholder - nothing here is a real credential.

APP_ENV=demo
# Where the synthetic demo dataset is written.
DB_PATH=./data/app.db
# Public bind address. Keep this on localhost unless you have a reason.
HOST=127.0.0.1
PORT=3000
# Log verbosity: debug | info | warning | error
LOG_LEVEL=info

# --- optional: connect a real backend instead of the demo seeder --------------
# ERP_DATABASE_URL=postgresql://user:${REDACTED}@localhost:5432/dbname
# ERP_API_KEY=
